{
  "name": "rag-learning-explorer",
  "private": true,
  "workspaces": [
    "v1/backend",
    "v1/frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm run dev -w v1/backend\" \"npm run dev -w v1/frontend\"",
    "build": "npm run build -w v1/frontend && npm run build -w v1/backend",
    "start": "npm run start -w v1/backend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w v1/backend",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:prepare": "npm run build && node v1/desktop/scripts/prepareDesktopApplication.mjs",
    "desktop:dev": "npm run desktop:prepare && node v1/desktop/scripts/launchDesktopDevelopment.mjs",
    "desktop:package": "npm run desktop:prepare && electron-forge package v1/desktop/app",
    "desktop:make": "npm run desktop:prepare && electron-forge make v1/desktop/app",
    "test:desktop": "node tests/desktop/desktopApplicationSmokeTest.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.0",
    "electron": "^44.3.0",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "tar": "^7.5.22",
    "tmp": "^0.2.7"
  }
}
